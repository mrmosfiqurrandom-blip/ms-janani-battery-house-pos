rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Open access for POS operation and evaluation
    match /{document=**} {
      allow read, write: if true;
    }

    // 1. Users (roles: admin, manager, cashier)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Products
    match /products/{productId} {
      allow read, write: if true;
    }

    // 3. Categories, Brands, Units
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /brands/{brandId} {
      allow read, write: if true;
    }
    match /units/{unitId} {
      allow read, write: if true;
    }

    // 4. Customers
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 5. Suppliers & Commissions
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /supplierCommissions/{commissionId} {
      allow read, write: if true;
    }
    match /commissionPayments/{paymentId} {
      allow read, write: if true;
    }

    // 6. Sales & Line Items
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /sale_items/{itemId} {
      allow read, write: if true;
    }
    match /saleItems/{itemId} {
      allow read, write: if true;
    }

    // 7. Sales Returns
    match /sales_returns/{returnId} {
      allow read, write: if true;
    }
    match /salesReturns/{returnId} {
      allow read, write: if true;
    }

    // 8. Purchases & Line Items
    match /purchases/{purchaseId} {
      allow read, write: if true;
    }
    match /purchase_items/{itemId} {
      allow read, write: if true;
    }
    match /purchaseItems/{itemId} {
      allow read, write: if true;
    }

    // 9. Purchase Returns
    match /purchase_returns/{returnId} {
      allow read, write: if true;
    }
    match /purchaseReturns/{returnId} {
      allow read, write: if true;
    }

    // 10. Stock Movements
    match /stock_movements/{movementId} {
      allow read, write: if true;
    }
    match /stockMovements/{movementId} {
      allow read, write: if true;
    }

    // 11. Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }
    match /customerPayments/{paymentId} {
      allow read, write: if true;
    }
    match /supplierPayments/{paymentId} {
      allow read, write: if true;
    }

    // 12. Expenses & Categories
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /expenseCategories/{catId} {
      allow read, write: if true;
    }

    // 13. Buyback Records & Old Battery Stock
    match /buyback_records/{recordId} {
      allow read, write: if true;
    }
    match /oldBatteryBuybacks/{buybackId} {
      allow read, write: if true;
    }
    match /oldBatteryStock/{batteryId} {
      allow read, write: if true;
    }

    // 14. Accounts & Banking
    match /accounts/{accountId} {
      allow read, write: if true;
    }
    match /accountTransactions/{txId} {
      allow read, write: if true;
    }
    match /accountTransfers/{transferId} {
      allow read, write: if true;
    }

    // 15. Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 16. Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
